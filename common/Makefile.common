##############################################################################
# Common Makefile for Cryptographic Engineering Assignments
#
# This file is included by assignment-specific Makefiles.
# It provides rules for building Jasmin code, C code, and firmware.
##############################################################################

# Toolchain
PREFIX ?= arm-none-eabi-
CC      = $(PREFIX)gcc
AS      = $(PREFIX)as
LD      = $(PREFIX)ld
OBJCOPY = $(PREFIX)objcopy
OBJDUMP = $(PREFIX)objdump
SIZE    = $(PREFIX)size
GDB     = $(PREFIX)gdb

# Jasmin compiler
JASMINC ?= jasminc

# OpenOCD
OPENOCD ?= openocd
# Serial number of the debug probe to use (only needed if several are connected)
OPENOCD_SERIAL ?=
OPENOCD_FLAGS = $(if $(OPENOCD_SERIAL),-c "adapter serial $(OPENOCD_SERIAL)") -f $(OPENOCD_CFG)

# Serial port of the board UART (empty: the test scripts auto-detect it)
SERIAL_PORT ?=
export SERIAL_PORT

# QEMU
QEMU ?= qemu-system-arm
QEMU_MACHINE ?= mps2-an386
QEMU_FLAGS = -M $(QEMU_MACHINE) -nographic -semihosting

# Platform selection (default: board)
#   board            - Nucleo-L4R5ZI
#   stm32l476rg      - Nucleo-L476RG, UART on PA2 (TX) / PA3 (RX) via the ST-LINK VCP
#   stm32f4discovery - STM32F407VG (STM32F4DISCOVERY), UART on PA2 (TX) / PA3 (RX)
#   qemu             - QEMU mps2-an386 emulation
PLATFORM ?= board

# Target device configuration
ifeq ($(PLATFORM),qemu)
  DEVICE = CMSDK_CM4
  ARCH = cortex-m4
  FPU = fpv4-sp-d16
  LDSCRIPT ?= $(COMMON_DIR)/mps2.ld
  HAL_SRC = $(COMMON_DIR)/hal/hal-qemu.c
  HAL_OBJ = $(HAL_SRC:.c=.o)
  STARTUP_SRC = $(COMMON_DIR)/mps2/startup_MPS2.S
else ifeq ($(PLATFORM),stm32f4discovery)
  DEVICE = STM32F407VG
  ARCH = cortex-m4
  FPU = fpv4-sp-d16
  LDSCRIPT ?= $(COMMON_DIR)/stm32f407vg.ld
  HAL_SRC = $(COMMON_DIR)/hal/hal.c
  HAL_OBJ = $(COMMON_DIR)/hal/hal-stm32f4.o
  STARTUP_SRC =
  OPENCM3_TARGET = stm32/f4
  OPENCM3_FAMILY = STM32F4
  BOARD_DEFINE = STM32F4DISCOVERY_BOARD
  OPENOCD_CFG ?= board/stm32f4discovery.cfg
else ifeq ($(PLATFORM),stm32l476rg)
  DEVICE = STM32L476RG
  ARCH = cortex-m4
  FPU = fpv4-sp-d16
  LDSCRIPT ?= $(COMMON_DIR)/stm32l476rg.ld
  HAL_SRC = $(COMMON_DIR)/hal/hal.c
  # Distinct from the L4R5ZI object: both are OPENCM3_FAMILY=STM32L4 but the
  # HAL compiles differently for each, so they must not share an output file.
  HAL_OBJ = $(COMMON_DIR)/hal/hal-stm32l476rg.o
  STARTUP_SRC =
  OPENCM3_TARGET = stm32/l4
  OPENCM3_FAMILY = STM32L4
  BOARD_DEFINE = NUCLEO_L476RG_BOARD
  OPENOCD_CFG ?= board/st_nucleo_l4.cfg
else ifeq ($(PLATFORM),board)
  DEVICE = STM32L4R5ZI
  ARCH = cortex-m4
  FPU = fpv4-sp-d16
  LDSCRIPT ?= $(COMMON_DIR)/stm32l4r5zi.ld
  HAL_SRC = $(COMMON_DIR)/hal/hal.c
  HAL_OBJ = $(COMMON_DIR)/hal/hal-stm32l4.o
  STARTUP_SRC =
  OPENCM3_TARGET = stm32/l4
  OPENCM3_FAMILY = STM32L4
  BOARD_DEFINE = NUCLEO_L4R5ZI_BOARD
  OPENOCD_CFG ?= board/st_nucleo_l4.cfg
else
  $(error Unknown PLATFORM '$(PLATFORM)', use board, stm32l476rg, stm32f4discovery or qemu)
endif

# Paths
COMMON_DIR = $(REPO_ROOT)/common
LIBOPENCM3_DIR = $(COMMON_DIR)/libopencm3
HAL_DIR = $(COMMON_DIR)/hal
MPS2_DIR = $(COMMON_DIR)/mps2

# libopencm3 configuration (only for board platforms)
OPENCM3_DIR = $(LIBOPENCM3_DIR)
OPENCM3_LIB = opencm3_$(subst /,,$(OPENCM3_TARGET))
LIBOPENCM3 = $(LIBOPENCM3_DIR)/lib/lib$(OPENCM3_LIB).a

# Compiler flags
ARCH_FLAGS = -mthumb -mcpu=$(ARCH) -mfloat-abi=hard -mfpu=$(FPU)
CFLAGS += $(ARCH_FLAGS)
CFLAGS += -I$(HAL_DIR)
CFLAGS += -I$(SRC_DIR)
CFLAGS += -Wall -Wextra -Wimplicit-function-declaration
CFLAGS += -Wredundant-decls -Wmissing-prototypes -Wstrict-prototypes
CFLAGS += -fno-common -ffunction-sections -fdata-sections
CFLAGS += -MD -MP
CFLAGS += -g3 -O2

# Platform-specific compiler flags
ifeq ($(PLATFORM),qemu)
  CFLAGS += -I$(MPS2_DIR)
  CFLAGS += -DQEMU_PLATFORM
  CFLAGS += -DDATA_IN_FLASH
  ASFLAGS += -DDATA_IN_FLASH
else
  CFLAGS += -D$(OPENCM3_FAMILY)
  # Distinguishes boards within one family: both Nucleos are STM32L4, but they
  # differ in console pins, maximum clock and flash wait states.
  CFLAGS += -D$(BOARD_DEFINE)
  CFLAGS += -I$(LIBOPENCM3_DIR)/include
endif

# Linker flags
LDFLAGS += $(ARCH_FLAGS)
LDFLAGS += -L$(SRC_DIR)
LDFLAGS += -T$(LDSCRIPT)
LDFLAGS += -nostartfiles
LDFLAGS += -Wl,--gc-sections
LDFLAGS += -Wl,-Map=$(BUILD_DIR)/$(TARGET).map
LDFLAGS += --specs=nano.specs

# Platform-specific linker flags and libraries
ifeq ($(PLATFORM),qemu)
  LDLIBS += -lc -lnosys -lm
else
  LDFLAGS += -L$(LIBOPENCM3_DIR)/lib
  LDLIBS += -l$(OPENCM3_LIB)
  LDLIBS += -lc -lnosys -lm
endif

# Jasmin flags
JASMINFLAGS += -arch arm-m4
# JASMINFLAGS += -CT
JASMINFLAGS += -system linux

# Object files (platform-specific)
ifeq ($(PLATFORM),qemu)
  OBJS += $(HAL_OBJ)
  OBJS += $(STARTUP_SRC:.S=.o)
else
  OBJS += $(HAL_OBJ)
endif

# Objects are built next to their sources, so rebuild them all when PLATFORM
# changes (otherwise e.g. a QEMU build would be linked/flashed for the board)
PLATFORM_STAMP = $(BUILD_DIR)/.platform-$(PLATFORM)

$(PLATFORM_STAMP):
	@mkdir -p $(BUILD_DIR)
	@rm -f $(BUILD_DIR)/.platform-*
	@touch $@

$(OBJS): $(PLATFORM_STAMP)

# Build rules
.PHONY: all clean flash monitor debug size libopencm3 qemu-gdb

all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).bin $(BUILD_DIR)/$(TARGET).hex
	@$(SIZE) $(BUILD_DIR)/$(TARGET).elf

ifeq ($(PLATFORM),qemu)
$(BUILD_DIR)/$(TARGET).elf: $(OBJS) $(LDSCRIPT)
	@mkdir -p $(BUILD_DIR)
	@echo "  LD      $@"
	@$(CC) $(LDFLAGS) $(OBJS) $(LDLIBS) -o $@
else
$(BUILD_DIR)/$(TARGET).elf: $(OBJS) $(LIBOPENCM3)
	@mkdir -p $(BUILD_DIR)
	@echo "  LD      $@"
	@$(CC) $(LDFLAGS) $(OBJS) $(LDLIBS) -o $@
endif

$(BUILD_DIR)/$(TARGET).bin: $(BUILD_DIR)/$(TARGET).elf
	@echo "  OBJCOPY $@"
	@$(OBJCOPY) -O binary $< $@

$(BUILD_DIR)/$(TARGET).hex: $(BUILD_DIR)/$(TARGET).elf
	@echo "  OBJCOPY $@"
	@$(OBJCOPY) -O ihex $< $@

%.o: %.c
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) -c $< -o $@

# The libopencm3 HAL is shared by all targets, so name its object per family
ifneq ($(PLATFORM),qemu)
$(HAL_OBJ): $(HAL_SRC)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) -c $< -o $@
endif

%.o: %.s
	@echo "  AS      $<"
	@$(AS) $(ARCH_FLAGS) $< -o $@

%.o: %.S
	@echo "  AS      $<"
	@$(CC) $(ARCH_FLAGS) $(CFLAGS) -c $< -o $@

# Jasmin compilation
%.s: %.jazz
	@echo "  JASMINC $<"
	@$(JASMINC) $(JASMINFLAGS) -o $@ $<

# libopencm3
$(LIBOPENCM3):
	@echo "Building libopencm3..."
	@if [ ! -d "$(LIBOPENCM3_DIR)" ]; then \
		echo "Error: libopencm3 not found at $(LIBOPENCM3_DIR)"; \
		echo "Please run: git submodule update --init --recursive"; \
		exit 1; \
	fi
	$(MAKE) -C $(LIBOPENCM3_DIR) TARGETS=$(OPENCM3_TARGET)

libopencm3: $(LIBOPENCM3)

# Flashing
flash: $(BUILD_DIR)/$(TARGET).bin
	@echo "Flashing $(BUILD_DIR)/$(TARGET).bin..."
	$(OPENOCD) $(OPENOCD_FLAGS) \
		-c "init" \
		-c "reset init" \
		-c "flash write_image erase $(BUILD_DIR)/$(TARGET).bin 0x08000000" \
		-c "reset run" \
		-c "shutdown"

# Serial monitor
monitor:
	@echo "Opening serial monitor (press Ctrl+C to exit)..."
	@python3 -m serial.tools.miniterm $(or $(SERIAL_PORT),/dev/ttyACM0) 38400 --eol LF

# Debugging
debug: $(BUILD_DIR)/$(TARGET).elf
	@echo "Starting OpenOCD server..."
	@$(OPENOCD) $(OPENOCD_FLAGS) &
	@sleep 2
	@echo "Starting GDB..."
	@$(GDB) -ex "target extended-remote localhost:3333" \
		-ex "monitor reset halt" \
		-ex "load" \
		-ex "monitor reset init" \
		$(BUILD_DIR)/$(TARGET).elf

# MPS2 linker script preprocessing (for QEMU platform)
$(COMMON_DIR)/mps2.ld: $(MPS2_DIR)/MPS2.ld
	@echo "  CPP     $@"
	@$(CC) -x c -E -P -DDATA_IN_FLASH $< -o $@

# QEMU emulation - GDB debugging only
qemu-gdb: $(BUILD_DIR)/$(TARGET).elf
	@echo "Starting QEMU with GDB server on port 1234..."
	@$(QEMU) $(QEMU_FLAGS) -kernel $< -s -S &
	@sleep 1
	@$(GDB) -ex "target remote localhost:1234" \
		-ex "load" \
		$<

# Show size
size: $(BUILD_DIR)/$(TARGET).elf
	@$(SIZE) $<
	@$(SIZE) -A $<

# Disassembly
disasm: $(BUILD_DIR)/$(TARGET).elf
	@$(OBJDUMP) -D $< > $(BUILD_DIR)/$(TARGET).dis
	@echo "Disassembly written to $(BUILD_DIR)/$(TARGET).dis"

# Clean
clean:
	@echo "Cleaning..."
	@rm -rf $(BUILD_DIR)
	@rm -f $(OBJS)
	@rm -f $(OBJS:.o=.d)
	@rm -f $(HAL_OBJ) $(HAL_OBJ:.o=.d)
	@rm -f $(STARTUP_SRC:.S=.o)
	@rm -f $(COMMON_DIR)/mps2.ld
	@find $(SRC_DIR) -name "*.s" -type f -delete
	@find $(SRC_DIR) -name "*.o" -type f -delete
	@find $(HAL_DIR) -name "*.o" -type f -delete
	@find $(HAL_DIR) -name "*.d" -type f -delete
	@find $(MPS2_DIR) -name "*.o" -type f -delete

clean-all: clean
	@if [ "$(PLATFORM)" != "qemu" ]; then \
		$(MAKE) -C $(LIBOPENCM3_DIR) clean; \
	fi

# Include dependency files
-include $(OBJS:.o=.d)

# Help
help:
	@echo "Available targets:"
	@echo "  all          - Build firmware (default)"
	@echo "  clean        - Clean build artifacts"
	@echo "  clean-all    - Clean everything including libopencm3"
	@echo ""
	@echo "Physical board targets:"
	@echo "  flash        - Flash firmware to board"
	@echo "  monitor      - Open serial monitor"
	@echo "  debug        - Start debugging session"
	@echo ""
	@echo "QEMU emulation targets:"
	@echo "  qemu-gdb     - Run in QEMU with GDB debugging"
	@echo ""
	@echo "Other targets:"
	@echo "  size         - Show firmware size"
	@echo "  disasm       - Generate disassembly"
	@echo "  libopencm3   - Build libopencm3 (board only)"
	@echo "  help         - Show this help"
	@echo ""
	@echo "Platform selection:"
	@echo "  PLATFORM=board            - Build for Nucleo-L4R5ZI board (default)"
	@echo "  PLATFORM=stm32l476rg      - Build for Nucleo-L476RG board"
	@echo "  PLATFORM=stm32f4discovery - Build for STM32F407 (STM32F4DISCOVERY) board"
	@echo "  PLATFORM=qemu             - Build for QEMU mps2-an386 emulation"
	@echo ""
	@echo "Board options:"
	@echo "  SERIAL_PORT=<dev>         - UART device for tests/monitor (default: auto-detect)"
	@echo "  OPENOCD_SERIAL=<serial>   - Select the ST-LINK when several are connected"
	@echo ""
	@echo "Examples:"
	@echo "  make PLATFORM=qemu           # Build for QEMU"
	@echo "  make PLATFORM=qemu qemu-gdb  # Build and debug in QEMU"
	@echo "  make PLATFORM=stm32f4discovery SERIAL_PORT=/dev/ttyUSB0 test-board"
	@echo "  make PLATFORM=stm32l476rg SERIAL_PORT=/dev/ttyACM0 test-board"
